# =============================================================================
# WFG AI SALES ENGINE — ENVIRONMENT
# Copy this file to `.env` and fill in the values.
# Anything left blank runs in SAFE MOCK MODE (logs instead of calling the API),
# so the app boots and is testable before the client delivers credentials.
#
# Legend:
#   [CLIENT]  = we are waiting on the client to provide this
#   [DECIDE]  = a business decision / default you can confirm
#   [AUTO]    = filled automatically by a script after first run
# =============================================================================

# --- Server -------------------------------------------------------------------
PORT=3000
# Public HTTPS URL Vapi will call for tool calls + end-of-call webhook.
# Use an ngrok/Cloudflare tunnel in dev, your deployed URL in prod.
PUBLIC_BASE_URL=https://your-server.example.com
LOG_LEVEL=info
# Optional shared secret. If set, we reject Vapi webhooks whose
# `x-vapi-secret` header does not match. Recommended in production.
VAPI_WEBHOOK_SECRET=

# --- Vapi (voice agent) -------------------------------------------------------
VAPI_API_KEY=                       # [CLIENT] Vapi private API key
VAPI_ASSISTANT_ID=                  # [AUTO] set after `npm run deploy:vapi`
VAPI_PHONE_NUMBER_ID=               # [AUTO/CLIENT] Vapi phone number id once Twilio is linked
VAPI_VOICE_PROVIDER=11labs          # [DECIDE] TTS provider (11labs | azure | playht | deepgram)
VAPI_VOICE_ID=paula                 # [DECIDE] a FEMALE voice id for the chosen provider
VAPI_TRANSCRIBER_LANGUAGE=multi     # EN + ES language detection

# --- Pricing config (HASS Lease estimator) ------------------------------------
# These encode the formula from the client's Master System Prompt. Change only
# with client sign-off — they drive both the spoken quote and the PDF.
DDP_MULTIPLIER=1.25
LEASE_TERM_MONTHS=36
MIN_FACTORY_BASELINE=50000
HASS_TIER2_MIN=200000               # DDP >= this -> tier 2
HASS_TIER3_MIN=1000000              # DDP >  this -> tier 3
HASS_TIER1_FLAT=400                 # DDP < 200k  : +$400/mo
HASS_TIER2_FLAT=800                 # 200k..1M    : +$800/mo
HASS_TIER3_PCT=0.015                # > 1M        : +1.5% of DDP /mo
DISCOUNT_2_UNITS=0.05               # 2 units  -> 5%
DISCOUNT_3PLUS_UNITS=0.10           # [DECIDE] 3+ units -> 10%..15% (default 10%)
ONSITE_ENGINEER_MONTHLY=13500       # [DECIDE] Total-Engineer add-on ($12k..$15k)
SPOKEN_ROUND_TO=10                  # round the quoted monthly to nearest $10

# --- HubSpot CRM --------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=               # [CLIENT] private-app token (crm.objects.contacts/deals rw)
HUBSPOT_PIPELINE_ID=default         # [CLIENT/DECIDE] which deal pipeline
HUBSPOT_DEALSTAGE_ID=appointmentscheduled  # [CLIENT/DECIDE] initial deal stage

# --- Proposal generation ------------------------------------------------------
# 'google' = copy a Google Docs template, merge fields, export PDF (production).
# 'local'  = render a self-contained PDF with pdfkit (works with no creds; good for testing).
PROPOSAL_PROVIDER=local
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json  # [CLIENT] service account w/ Docs+Drive
GOOGLE_DOC_TEMPLATE_ID=             # [CLIENT] file id of the Google Docs proposal template
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=      # [CLIENT] Drive folder id to store generated PDFs

# --- Email (SMTP) -------------------------------------------------------------
# 'smtp' sends real mail; 'mock' just logs. Falls back to mock if SMTP_HOST is blank.
EMAIL_PROVIDER=smtp
SMTP_HOST=                          # [CLIENT] e.g. smtp.gmail.com / smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=                          # [CLIENT]
SMTP_PASS=                          # [CLIENT]
EMAIL_FROM=WFG Holding LLC <noreply@wyomingfrontierglobal.com>   # [CLIENT] verified sender
MANAGEMENT_EMAIL=management@wyomingfrontierglobal.com

# --- Twilio (telephony) -------------------------------------------------------
# Usually linked INSIDE Vapi. Provided here only if you provision via Twilio API.
TWILIO_ACCOUNT_SID=                 # [CLIENT] pending "compliance" approval
TWILIO_AUTH_TOKEN=                  # [CLIENT]
TWILIO_PHONE_NUMBER=                # [CLIENT]

# --- Company details (printed on the proposal) --------------------------------
COMPANY_NAME=Wyoming Frontier Global LLC
COMPANY_ADDRESS=1603 Capitol Ave, Suite 414, Cheyenne, WY 82001, USA
COMPANY_WEBSITE=wyomingfrontierglobal.com
